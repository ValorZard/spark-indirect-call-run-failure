project Spark_Indirect_Call is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("main_s.adb");

   package Builder is
      for Global_Configuration_Pragmas use "gnat.adc";
   end Builder;

   package Compiler is
      --  -gnata so the proved assertion is actually evaluated at run time.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Spark_Indirect_Call;
